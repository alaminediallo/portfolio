---
import { SITE } from "@/data/site";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<nav aria-label={t("nav.aria")}>
  <ul class="mt-12 hidden w-max space-y-1 lg:block">
    {
      SITE.nav.map((item) => (
        <li>
          <a
            href={item.href}
            data-section={item.href.replace("#", "")}
            class="nav-link group focus-ring text-slate hover:text-slate-lightest data-active:text-slate-lightest ease-out-quad flex items-center gap-4 py-3 text-xs font-bold tracking-widest uppercase transition-[color] duration-150"
          >
            {/* Base width is the expanded size; the resting state is a scaleX, so
                the indicator animates on the compositor instead of triggering
                layout the way an animated `width` would. Tailwind v4 compiles
                scale-* to the standalone `scale` property, hence the
                transition targets `scale` rather than `transform`. */}
            <span class="nav-line bg-slate group-hover:bg-slate-lightest group-data-active:bg-slate-lightest ease-out-quad block h-px w-16 origin-left scale-x-50 transition-[scale,background-color] duration-200 group-hover:scale-x-100 group-data-active:scale-x-100" />
            <span class="nav-label">{t(item.key)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  /** Matches the top edge of the IntersectionObserver band below. */
  const BAND_TOP_RATIO = 0.4;
  const ROOT_MARGIN = "-40% 0px -55% 0px";

  const sections = Array.from(
    document.querySelectorAll<HTMLElement>("section[id]"),
  );
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("a[data-section]"),
  );

  if (sections.length > 0 && navLinks.length > 0) {
    /** Ids of the sections currently crossing the detection band. */
    const sectionsInBand = new Set<string>();

    function setActive(id: string) {
      navLinks.forEach((link) => {
        const isActive = link.dataset.section === id;
        // `data-active` drives every visual state, so the stylesheet stays the
        // single source of truth and no longer fights the hover utilities.
        link.toggleAttribute("data-active", isActive);
        // "location" is the ARIA token for the current spot within a page.
        if (isActive) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    }

    function resolveActive() {
      const inBand = sections.find((section) => sectionsInBand.has(section.id));
      if (inBand) {
        setActive(inBand.id);
        return;
      }

      // Nothing is crossing the band: at the very top, past the last section,
      // or mid fast-scroll. Fall back to the last section already scrolled past
      // so the indicator never gets stuck on a stale entry.
      const bandTop = window.innerHeight * BAND_TOP_RATIO;
      const passed = sections.filter(
        (section) => section.getBoundingClientRect().top <= bandTop,
      );
      setActive((passed.at(-1) ?? sections[0]).id);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) sectionsInBand.add(entry.target.id);
          else sectionsInBand.delete(entry.target.id);
        });
        resolveActive();
      },
      { rootMargin: ROOT_MARGIN },
    );

    sections.forEach((section) => observer.observe(section));
    resolveActive();
  }
</script>
