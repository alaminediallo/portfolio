---
import { SITE } from "../data/site.ts";
import Nav from "./Nav.astro";
import SocialLinks from "./SocialLinks.astro";
---

<div class="flex h-full flex-col justify-between">
  <div>
    <a href="/" class="block">
      <h1
        class="text-slate-lightest text-4xl font-bold font-display tracking-tight sm:text-5xl"
      >
        {SITE.name}
      </h1>
    </a>

    <h2 class="text-slate-lightest mt-3 text-lg font-medium font-display tracking-tight">
      {SITE.title}
    </h2>
    <p class="text-slate mt-4 max-w-xs leading-normal">
      {SITE.tagline}
    </p>

    <Nav />
  </div>

  <SocialLinks />
</div>
