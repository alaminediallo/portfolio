---
import { type CollectionEntry, render } from "astro:content";
import Tag from "@/components/ui/Tag.astro";
import IconArrowUp from "@/components/icons/IconArrowUp.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

type Props = {
  entry: CollectionEntry<"experience">;
};

const { entry } = Astro.props;
const { Content } = await render(entry);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<li
  class="group ease-out-quad relative grid pb-1 transition-opacity duration-200 sm:grid-cols-8 sm:gap-8 md:gap-4 lg:group-hover/list:opacity-50 lg:hover:opacity-100!"
>
  <div
    class="lg:group-hover:bg-navy-light ease-out-quad absolute -inset-4 z-0 hidden rounded-md transition-[background-color,box-shadow] duration-200 lg:block lg:group-hover:shadow-lg lg:group-hover:inset-shadow-[0_1px_0_0_rgba(148,163,184,0.1)]"
  >
  </div>

  <header
    class="text-slate z-10 mt-1 mb-2 text-xs font-semibold tracking-wide uppercase sm:col-span-2"
  >
    {entry.data.range}
  </header>

  <div class="z-10 sm:col-span-6">
    <h3 class="text-slate-lightest leading-snug font-medium">
      <a
        class="group/link focus-ring ease-out-quad text-slate-lightest hover:text-teal focus-visible:text-teal inline-flex items-baseline gap-1 leading-tight font-medium transition-[color] duration-150"
        href={entry.data.wip ? "#" : entry.data.url}
        {...entry.data.wip
          ? { "data-wip": "true" }
          : { target: "_blank", rel: "noopener noreferrer" }}
      >
        <span
          class="absolute -inset-4 hidden rounded md:block"
          aria-hidden="true"></span>
        {entry.data.title}
        <span
          class="text-slate-lightest group-hover/link:text-teal inline-block"
          >·</span
        >
        <span class="whitespace-nowrap">{entry.data.company}</span>

        <IconArrowUp
          class="ml-1 inline-block size-4 shrink-0 translate-y-0.5 transition-transform group-hover/link:translate-x-1 group-hover/link:-translate-y-0.5 group-focus-visible/link:translate-x-1 group-focus-visible/link:-translate-y-0.5"
        />
      </a>
    </h3>

    <div
      class="prose-sm text-slate [&_a]:text-slate-lightest [&_a:hover]:text-teal [&_a]:decoration-slate/50 mt-2 text-sm leading-normal [&_a]:font-medium [&_a]:underline"
    >
      <Content />
    </div>

    <ul class="mt-5 flex flex-wrap gap-2" aria-label={t("tech.aria")}>
      {entry.data.tech.map((tech) => <Tag label={tech} />)}
    </ul>
  </div>
</li>
