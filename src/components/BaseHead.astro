---
import "@/styles/global.css";
import { SITE } from "@/data/site";
import { Font } from "astro:assets";
import {
  alternatePath,
  getLangFromUrl,
  useTranslations,
} from "@/i18n/utils";

export type Props = {
  title?: string;
  description?: string;
  image?: string;
};

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = `${SITE.name} | ${t("site.title")}`,
  description = t("site.tagline"),
  image = "/images/og/og-image.png",
} = Astro.props;

const websiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const enHref = new URL(alternatePath(Astro.url, "en"), Astro.site);
const frHref = new URL(alternatePath(Astro.url, "fr"), Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0a192f" />
<meta name="color-scheme" content="dark" />

<script is:inline>
  (function () {
    try {
      var pref = localStorage.getItem("lang-pref");
      if (pref) return;
      var path = location.pathname;
      var alreadyFr = path === "/fr" || path.indexOf("/fr/") === 0;
      var navLang = (navigator.language || "").toLowerCase();
      if (navLang.indexOf("fr") === 0 && !alreadyFr) {
        localStorage.setItem("lang-pref", "fr");
        var target = "/fr" + (path === "/" ? "" : path);
        location.replace(target);
      }
    } catch (e) {
      /* localStorage indispo */
    }
  })();
</script>

<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="en" href={enHref} />
<link rel="alternate" hreflang="fr" href={frHref} />
<link rel="alternate" hreflang="x-default" href={enHref} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.name} />
<meta name="robots" content="index, follow" />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={t("html.locale")} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" href="favicons/favicon.ico" sizes="32x32" />
<link rel="icon" href="favicons/favicon-32.png" sizes="32x32" />
<link rel="icon" href="favicons/favicon-48.png" sizes="48x48" />
<link
  rel="apple-touch-icon"
  href="favicons/apple-touch-icon-57x57.png"
  sizes="57x57"
/>
<link
  rel="apple-touch-icon"
  href="favicons/apple-touch-icon-114x114.png"
  sizes="114x114"
/>
<link
  rel="apple-touch-icon"
  href="favicons/apple-touch-icon-120x120.png"
  sizes="120x120"
/>
<link
  rel="apple-touch-icon"
  href="favicons/apple-touch-icon-180x180.png"
  sizes="180x180"
/>

<meta name="generator" content={Astro.generator} />
<Font cssVariable="--font-inter" />
<Font cssVariable="--font-inknut-antiqua" />

{websiteId && (
  <script
    is:inline
    defer
    src="https://bip.laminediallo.me/bip"
    data-website-id={websiteId}
    data-domains="laminediallo.me"
    data-exclude-hash="true"
    data-performance="true"
  ></script>
  <script
    is:inline
    defer
    src="https://bip.laminediallo.me/recorder.js"
    data-website-id={websiteId}
    data-sample-rate="0.5"
    data-mask-level="moderate"
    data-max-duration="300000"
  ></script>
)}
