---
import { getCollection } from "astro:content";
import ProjectCard from "@/components/cards/ProjectCard.astro";
import IconArrow from "@/components/icons/IconArrow.astro";
import { getLangFromUrl, localizedPath, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allProjects = await getCollection("projects", (entry) =>
  entry.id.startsWith(`${lang}/`),
);
const FEATURED_LIMIT = 4;
const featured = allProjects
  .filter((p) => p.data.type === "featured")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, FEATURED_LIMIT);

const archiveHref = localizedPath(lang, "/archive");
---

<section
  id="projects"
  class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24"
>
  <div
    class="sticky top-0 z-20 -mx-6 mb-4 bg-slate-900/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0"
  >
    <h2
      class="text-slate-lightest text-sm font-bold tracking-widest uppercase lg:sr-only"
    >
      {t("section.projects.heading")}
    </h2>
  </div>

  <ul class="group/list space-y-10">
    {featured.map((entry) => <ProjectCard entry={entry} />)}
  </ul>

  <div class="mt-12">
    <a
      href={archiveHref}
      class="group text-slate-lightest hover:text-teal inline-flex items-center gap-1 font-semibold"
      data-umami-event="archive-view"
    >
      {t("section.projects.viewArchive")}
      <IconArrow
        class="size-4 transition-transform group-hover:translate-x-1"
      />
    </a>
  </div>
</section>
