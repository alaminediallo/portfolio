---
import { SITE } from "@/data/site.ts";
import { getLangFromUrl, localizedPath, type Lang } from "@/i18n/utils";

type Props = {
  href?: string;
  text?: string;
  lang?: Lang;
};

const { lang: langProp, ...rest } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const { href = localizedPath(lang, "/"), text = SITE.name } = rest;
---

<a
  href={href}
  class="group relative z-20 mb-2 inline-flex items-center gap-1 font-semibold text-teal-300"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-4 transition-transform group-hover:-translate-x-2"
    aria-hidden="true"
  >
    <line x1="19" y1="12" x2="5" y2="12"></line>
    <polyline points="12 19 5 12 12 5"></polyline>
  </svg>
  {text}
</a>
