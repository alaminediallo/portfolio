---
import Layout from "@/layouts/Layout.astro";
import BackButton from "@/components/BackButton.astro";
import { getLangFromUrl, useTranslations, type Lang } from "@/i18n/utils";

export type Props = {
  headTitle: string;
  headDescription: string;
  lang?: Lang;
};

const { headTitle, headDescription, lang: langProp } = Astro.props;

const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={headTitle} description={headDescription}>
  <main
    class="flex min-h-screen flex-col items-center justify-center px-6 py-24 text-center md:px-12"
  >
    <h1
      class="mb-10 text-8xl font-bold tracking-tight text-slate-200 sm:text-9xl"
    >
      <slot name="code" />
    </h1>
    <p class="mb-10 max-w-md text-slate-400">
      <slot name="message" />
    </p>
    <div class="mt-4">
      <BackButton text={t("error.returnHome")} lang={lang} />
    </div>
  </main>
</Layout>
