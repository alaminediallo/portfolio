---
import ErrorPage from "@/components/ui/ErrorPage.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ErrorPage
  headTitle={t("error.500.headTitle")}
  headDescription={t("error.500.headDescription")}
>
  <Fragment slot="code">500</Fragment>
  <Fragment slot="message">
    {t("error.500.message.line1")}
    <br />{t("error.500.message.line2")}
  </Fragment>
</ErrorPage>
