---
import ErrorPage from "@/components/ui/ErrorPage.astro";
import { useTranslations } from "@/i18n/utils";

const lang = "fr" as const;
const t = useTranslations(lang);
---

<ErrorPage
  headTitle={t("error.404.headTitle")}
  headDescription={t("error.404.headDescription")}
  lang={lang}
>
  <Fragment slot="code">404</Fragment>
  <Fragment slot="message">
    {t("error.404.message.line1")}
    <br />{t("error.404.message.line2")}
  </Fragment>
</ErrorPage>
