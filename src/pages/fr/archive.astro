---
import Layout from "@/layouts/Layout.astro";
import { archive } from "@/data/archive.ts";
import IconArrowUp from "@/components/icons/IconArrowUp.astro";
import IconGitHub from "@/components/icons/IconGitHub.astro";
import BackButton from "@/components/BackButton.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t("archive.meta.title")}
  description={t("archive.meta.description")}
>
  <div class="mx-auto min-h-screen max-w-7xl px-6 py-12 font-sans md:px-12 md:py-16 lg:py-24">
    <BackButton />

    <h1
      class="mb-4 text-4xl font-bold tracking-tight text-slate-200 sm:text-5xl"
    >
      {t("archive.title")}
    </h1>

    <table class="mt-16 w-full border-collapse text-left">
      <thead
        class="sticky top-0 z-10 border-b border-slate-300/10 bg-slate-900/75 px-6 py-5 backdrop-blur"
      >
        <tr>
          <th class="py-4 pr-8 text-sm font-semibold text-slate-200">{t("archive.col.year")}</th>
          <th class="py-4 pr-8 text-sm font-semibold text-slate-200">{t("archive.col.project")}</th>
          <th class="hidden py-4 pr-8 text-sm font-semibold text-slate-200 lg:table-cell">{t("archive.col.madeAt")}</th>
          <th class="hidden py-4 pr-8 text-sm font-semibold text-slate-200 lg:table-cell">{t("archive.col.builtWith")}</th>
          <th class="hidden py-4 pr-8 text-sm font-semibold text-slate-200 sm:table-cell">{t("archive.col.link")}</th>
        </tr>
      </thead>
      <tbody>
        {
          archive.map((entry) => (
            <tr class="border-b border-slate-300/10 last:border-none">
              <!-- Year -->
              <td class="py-4 pr-4 align-top text-sm">
                <div class="translate-y-px">{entry.year}</div>
              </td>

              <!-- Project name -->
              <td class="py-4 pr-4 align-top font-semibold leading-snug text-slate-200">
                <div>
                  {/* Mobile: show as clickable link */}
                  <div class="block sm:hidden">
                    {entry.url || entry.repo ? (
                      <a
                        href={entry.url ?? entry.repo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group/link inline-flex items-baseline font-medium leading-tight text-slate-200 text-base hover:text-teal-300"
                      >
                        <span class="inline-block">
                          {entry.title}
                          <IconArrowUp class="inline-block size-4 shrink-0 transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none" />
                        </span>
                      </a>
                    ) : entry.title}
                  </div>
                  {/* SM+: plain text (link shown in last column) */}
                  <p class="hidden sm:block">{entry.title}</p>
                </div>
              </td>

              <!-- Made at -->
              <td class="hidden py-4 pr-4 align-top text-sm lg:table-cell">
                  <p class="translate-y-px whitespace-nowrap">{entry.org}</p>
              </td>

              <!-- tags -->
              <td class="hidden py-4 pr-4 align-top lg:table-cell">
                <ul class="flex -translate-y-1.5 flex-wrap">
                  {entry.tech.map((tech) => (
                    <li class="my-1 mr-1.5">
                      <p class="flex items-center rounded-full bg-teal-400/10 px-3 py-1 text-xs font-medium leading-5 text-teal-300">
                        {tech}
                      </p>
                    </li>
                  ))}
                </ul>
              </td>

              <!-- Link -->
              <td class="hidden py-4 align-top sm:table-cell">
                <div class="flex translate-y-1 items-center gap-3">
                  {entry.url && (
                    <a
                      href={entry.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={t("card.live.aria", { title: entry.title })}
                      class="group/link inline-flex items-baseline text-sm text-slate-400 hover:text-teal-300"
                    >
                      <span class="inline-block whitespace-nowrap">
                        {new URL(entry.url).hostname.replace("www.", "")}
                        <IconArrowUp
                          class="inline-block size-4 shrink-0 transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
                        />
                      </span>
                    </a>
                  )}
                  {entry.repo && (
                    <a
                      href={entry.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={t("card.repo.aria", { title: entry.title })}
                      class="text-slate hover:text-teal transition-colors"
                    >
                      <IconGitHub class="size-5 shrink-0" />
                    </a>
                  )}
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Layout>
