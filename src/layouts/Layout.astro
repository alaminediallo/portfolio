---
import BaseHead from "@/components/BaseHead.astro";
import type { Props as HeadProps } from "@/components/BaseHead.astro";
import { getLangFromUrl } from "@/i18n/utils";

export type Props = HeadProps;

const lang = getLangFromUrl(Astro.url);
---

<html lang={lang}>
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <div
      id="cursor-glow"
      class="pointer-events-none fixed inset-0 z-30 transition-[background] duration-300"
      aria-hidden="true"
    >
    </div>

    <slot />

    <script>
      if (window.matchMedia("(pointer: fine)").matches) {
        const glow = document.getElementById("cursor-glow");
        if (glow) {
          document.addEventListener("mousemove", (e) => {
            glow.style.background = `radial-gradient(600px at ${e.clientX}px ${e.clientY}px, rgba(29, 78, 216, 0.15), transparent 80%)`;
          });
        }
      }
    </script>
    <script>
      const UTM_KEYS = [
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content",
        "utm_term",
      ];
      const FALLBACK_DELAY = 3000;
      const POLL_INTERVAL = 50;

      function cleanUtmFromUrl() {
        const url = new URL(window.location.href);
        const hasUtm = UTM_KEYS.some((key) => url.searchParams.has(key));
        if (!hasUtm) return;

        UTM_KEYS.forEach((key) => url.searchParams.delete(key));
        window.history.replaceState({}, document.title, url.toString());
      }

      function waitForUmamiThenClean() {
        if (window.umami) return cleanUtmFromUrl();

        const interval = setInterval(() => {
          if (window.umami) {
            clearInterval(interval);
            cleanUtmFromUrl();
          }
        }, POLL_INTERVAL);

        setTimeout(() => {
          clearInterval(interval);
          cleanUtmFromUrl();
        }, FALLBACK_DELAY);
      }

      window.addEventListener("load", waitForUmamiThenClean);
    </script>
  </body>
</html>
